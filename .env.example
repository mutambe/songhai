# Copia este ficheiro para ".env" (na VPS, ao lado do docker-stack.yml) e
# preenche com valores reais. O "docker stack deploy" lê este .env
# automaticamente para substituir as variáveis ${...} no stack.yml.
# NUNCA comitar o ".env" real — só este .example.

# Imagens a publicar (ajusta depois de construíres/publicares as imagens)
SITE_IMAGE=songhai-site:latest
PORTAL_IMAGE=songhai-portal:latest

# URLs públicos reais dos dois serviços
SITE_PUBLIC_URL=https://songhai.cc
PORTAL_PUBLIC_URL=https://portal.songhai.cc

# WhatsApp (número real, sem "+", sem espaços)
WHATSAPP_PHONE=258848986002

# Segredos — gera valores NOVOS para produção (nunca reaproveitar os de dev).
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
BLOG_ADMIN_SECRET=
SSO_SHARED_SECRET=

# SMTP (envio de e-mail — contacto, newsletter, reset de senha, 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=songhai.limitada@gmail.com
SMTP_PASS=
MAIL_FROM=songhai.limitada@gmail.com
CONTACT_NOTIFY_EMAIL=songhai.limitada@gmail.com
